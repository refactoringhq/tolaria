  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:web": "tsc -b && vite build --config apps/web/vite.config.ts",
    "preview:web": "vite preview --config apps/web/vite.config.ts",
    "upload:web-sourcemaps": "node --experimental-strip-types apps/web/scripts/upload-sourcemaps.ts",
    "codacy:gate": "node --test scripts/codacy-gate-lib.test.mjs && node scripts/codacy-gate.mjs",
    "codacy:gate:test": "node --test scripts/codacy-gate-lib.test.mjs",
    "agent-docs": "node scripts/build-agent-docs.mjs",
    "bundle-mcp": "node scripts/bundle-mcp-server.mjs",
    "docs:dev": "vitepress dev site --host 127.0.0.1",
    "docs:build": "pnpm agent-docs && vitepress build site",
    "docs:preview": "vitepress preview site --host 127.0.0.1",
    "lint": "eslint . --max-warnings=0",
    "l10n:translate": "lara-cli translate",
    "l10n:translate:force": "lara-cli translate --force",
    "l10n:validate": "node scripts/validate-locales.mjs",
    "perf": "pnpm build && node scripts/editor-performance-benchmark.mjs",
    "perf:ci": "pnpm build && node scripts/editor-performance-benchmark.mjs --iterations 5 --warmups 1",
    "perf:test": "node --test scripts/editor-performance-harness.test.mjs",
    "perf:update": "pnpm build && node scripts/editor-performance-benchmark.mjs --update",
    "perf:editor": "pnpm build && node scripts/editor-performance-benchmark.mjs --scenario small,large",
    "perf:editor:update": "pnpm build && node scripts/editor-performance-benchmark.mjs --scenario small,large --update",
    "preview": "vite preview",
    "tauri": "node scripts/tauri-cli.mjs",
    "test": "vitest run && node --test scripts/release-version.test.mjs scripts/appimage-launcher-tools.test.mjs && bash scripts/verify-pages-site.test.sh && pnpm test:web-config && pnpm test:server && pnpm test:dev-mock",
    "test:web-config": "node --experimental-strip-types --test apps/web/previewOptions.test.ts apps/web/phosphorIconChunk.test.ts apps/web/serviceWorkerPlugin.test.ts apps/web/appShellPreload.test.ts apps/web/bigVaultBudgets.test.ts apps/web/sentryWebBuild.test.ts apps/web/sourcemapUpload.test.ts apps/web/convergenceReport.test.ts",
    "test:server": "vitest run --config apps/server/vitest.config.ts --coverage",
    "server": "node --experimental-strip-types apps/server/scripts/run.ts apps/server/src/main.ts",
    "server:seed": "node --experimental-strip-types apps/server/scripts/seed-test-remote.ts",
    "server:bench": "node --experimental-strip-types apps/server/scripts/run.ts apps/server/scripts/bench.ts",
    "server:collab-bench": "node --experimental-strip-types apps/server/scripts/run.ts apps/server/scripts/collab-bench.ts",
    "test:dev-mock": "node --experimental-strip-types --test scripts/vault-api-plugin.test.mjs",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "playwright:smoke": "playwright test --config playwright.smoke.config.ts tests/smoke/autosave-low-end-typing.spec.ts tests/smoke/create-note-backing-file.spec.ts tests/smoke/create-edit-update-depth.spec.ts tests/smoke/delete-note-nonblocking.spec.ts tests/smoke/example.spec.ts tests/smoke/fix-crash-create-note.spec.ts tests/smoke/quick-open-create-note.spec.ts tests/smoke/save-before-note-switch.spec.ts tests/smoke/h1-untitled-auto-rename.spec.ts tests/smoke/keyboard-command-routing.spec.ts tests/smoke/missing-string-metadata-open-note.spec.ts tests/smoke/multibyte-search-snippet.spec.ts tests/smoke/new-note-first-property.spec.ts tests/smoke/new-note-title-focus.spec.ts tests/smoke/onboarding-vault-registration.spec.ts tests/smoke/pull-refresh-open-note.spec.ts tests/smoke/wikilink-cmd-click-history.spec.ts tests/smoke/wikilink-path-fix.spec.ts",
    "playwright:regression": "playwright test tests/smoke/",
    "playwright:web": "playwright test --config apps/web/playwright.config.ts",
    "bench:web": "playwright test --config apps/web/playwright.bench.config.ts",
    "playwright:integration": "playwright test --config playwright.integration.config.ts",
    "test:coverage": "node scripts/run-vitest-coverage.mjs",
    "prepare": "husky",
    "mobile:lint": "eslint apps/mobile --max-warnings=0",

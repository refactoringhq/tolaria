# Copy to tolaria.env (Docker) or /etc/tolaria/tolaria.env (systemd) or
# ~/.config/tolaria/tolaria.env (launchd), then fill in. Never commit the copy.
# Every setting: ../README.md, "Run".

# Owner token: full access. Generate with: openssl rand -hex 24
TOLARIA_SERVER_TOKEN=replace-with-output-of-openssl-rand-hex-24

# The vault's git remote. SSH form for a private repository with a deploy key.
TOLARIA_VAULT_REMOTE_URL=git@github.com:you/your-vault.git

# Optional: the branch to serve (default: the remote's default branch).
# TOLARIA_VAULT_BRANCH=main
